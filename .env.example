# ─── Database (Supabase Postgres) ──────────────────────────────────────────────
# Pooled connection string — used by the running app (PgBouncer, port 6543).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ham
# Direct connection — used by drizzle-kit for migrations (port 5432).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ham

# ─── Supabase Storage (media uploads) ──────────────────────────────────────────
SUPABASE_URL=
# Server-side only. Never prefix with NEXT_PUBLIC_ — it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# Safe to expose client-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ─── Seeded admin account (change the password after the first login) ──────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Where contact / membership / donation submissions are delivered.
CONTACT_TO_EMAIL=

# ─── Public ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Google Maps browser key for the qibla street map (Google Cloud →
# enable the "Map Tiles API" → an API key restricted to the site's domains).
# With it the map is drawn from Google's tiles and can be dragged; without it
# the map is Google's ordinary embed, moved by its buttons.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# SHA-256 of the Android app's signing key (see README → App). Optional.
ANDROID_CERT_SHA256=
