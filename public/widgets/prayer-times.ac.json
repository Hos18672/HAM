{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${title}", "weight": "Bolder", "wrap": true },
            { "type": "TextBlock", "text": "${place} · ${date}", "isSubtle": true, "size": "Small", "spacing": "None", "wrap": true }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        { "type": "TextBlock", "text": "${nextLabel}", "size": "Small", "isSubtle": true },
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "${nextName}", "weight": "Bolder", "color": "Accent", "wrap": true }] },
            { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "${nextTime}", "weight": "Bolder", "size": "ExtraLarge", "color": "Accent" }] }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Small",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${rows}",
          "spacing": "None",
          "columns": [
            { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "${de}", "size": "Small", "weight": "${if(next, 'Bolder', 'Default')}" }] },
            { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "${fa}", "size": "Small", "horizontalAlignment": "Right", "weight": "${if(next, 'Bolder', 'Default')}" }] },
            { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "${time}", "size": "Small", "weight": "${if(next, 'Bolder', 'Default')}", "color": "${if(next, 'Accent', 'Default')}" }] }
          ]
        }
      ]
    }
  ],
  "actions": [{ "type": "Action.Execute", "title": "اوقات شرعی · Alle Gebetszeiten", "verb": "open" }]
}
