<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView style="@style/WTitle" android:layout_width="wrap_content"
            android:textColor="@color/widget_accent" android:text="@string/verse_title" />
        <TextView android:id="@+id/verse_ref" style="@style/WSmall"
            android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp"
            android:maxLines="1" android:ellipsize="end" android:text="" />
        <ImageView android:id="@+id/verse_next" android:layout_width="32dp" android:layout_height="32dp"
            android:padding="6dp" android:src="@drawable/ic_refresh"
            android:contentDescription="@string/verse_next" />
    </LinearLayout>

    <TextView android:id="@+id/verse_ar"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:gravity="center" android:textDirection="rtl"
        android:textColor="@color/widget_ink" android:textSize="20sp" android:lineSpacingMultiplier="1.25"
        android:maxLines="4" android:ellipsize="end" android:text="@string/verse_missing" />

    <TextView android:id="@+id/verse_tr"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center"
        android:textColor="@color/widget_subtle" android:textSize="13sp"
        android:maxLines="3" android:ellipsize="end" android:text="" />
</LinearLayout>
