<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:id="@+id/dua_box"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/title" style="@style/WTitle" android:layout_width="0dp" android:layout_weight="1"
                android:textColor="@color/widget_accent" android:textSize="12sp" android:text="@string/dua_title" />
            <TextView android:id="@+id/lang" style="@style/WLang" />
        </LinearLayout>
        <TextView android:id="@+id/dua_name" style="@style/WTitle" android:layout_width="match_parent"
            android:textSize="18sp" android:maxLines="1" android:ellipsize="end" android:text="" />
        <TextView android:id="@+id/dua_arabic" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/widget_subtle" android:textSize="15sp" android:maxLines="1" android:text="" />
        <TextView android:id="@+id/dua_when" style="@style/WSmall" android:layout_width="match_parent"
            android:maxLines="2" android:ellipsize="end" android:text="" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/b_prayer"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginHorizontal="3dp" android:background="@drawable/chip_bg"
            android:gravity="center" android:orientation="vertical" android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_clock"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/l_prayer" style="@style/WSmall" android:layout_marginTop="2dp" android:textColor="@color/widget_ink"
                android:text="@string/btn_prayer" />
        </LinearLayout>
        <LinearLayout android:id="@+id/b_quran"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginHorizontal="3dp" android:background="@drawable/chip_bg"
            android:gravity="center" android:orientation="vertical" android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_book"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/l_quran" style="@style/WSmall" android:layout_marginTop="2dp" android:textColor="@color/widget_ink"
                android:text="@string/btn_quran" />
        </LinearLayout>
        <LinearLayout android:id="@+id/b_duas"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginHorizontal="3dp" android:background="@drawable/chip_bg"
            android:gravity="center" android:orientation="vertical" android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_hands"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/l_duas" style="@style/WSmall" android:layout_marginTop="2dp" android:textColor="@color/widget_ink"
                android:text="@string/btn_duas" />
        </LinearLayout>
        <LinearLayout android:id="@+id/b_qibla"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginHorizontal="3dp" android:background="@drawable/chip_bg"
            android:gravity="center" android:orientation="vertical" android:padding="4dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_compass"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/l_qibla" style="@style/WSmall" android:layout_marginTop="2dp" android:textColor="@color/widget_ink"
                android:text="@string/btn_qibla" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
